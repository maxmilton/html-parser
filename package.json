{
  "name": "@maxmilton/html-parser",
  "version": "0.0.14",
  "description": "An efficient, compact HTML5 parser with blistering speed.",
  "bugs": "https://github.com/maxmilton/html-parser/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/html-parser",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint --format=stylish",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=3"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.15",
    "@types/bun": "1.4.0",
    "dts-buddy": "0.8.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3"
  }
}
